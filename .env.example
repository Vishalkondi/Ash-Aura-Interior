# Copy to .env.local for local testing. On Vercel, set these under
# Project -> Settings -> Environment Variables, then redeploy.

# Resend API key (resend.com -> API Keys). Required for the enquiry and booking forms.
RESEND_API_KEY=

# Sender address on a domain verified in Resend. Needed for visitor auto-replies.
# Leave empty to use Resend's test sender (onboarding@resend.dev).
ENQUIRY_FROM=

# Where enquiries are delivered. Leave empty for ashaura.interiors@gmail.com.
ENQUIRY_TO=

# The live site address once a domain is connected, e.g. https://ashaura.in
NEXT_PUBLIC_SITE_URL=
